# ── AI integration (Phase 3) ──────────────────────────────────────────────
GEMINI_API_KEY=replace_with_your_real_key
GOOGLE_CLIENT_SECRETS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# ── Scanner defaults ──────────────────────────────────────────────────────
DEFAULT_SCAN_PATH=Documents
LOG_LEVEL=INFO

# ── Web Review Dashboard ──────────────────────────────────────────────────
# REVIEWER_PASSWORD: can view findings, confirm, and reject
# ADMIN_PASSWORD:    can also edit record fields and mark records for deletion
# FLASK_SECRET_KEY:  random string used to sign sessions — change before deploying
REVIEWER_PASSWORD=revisor123
ADMIN_PASSWORD=admin456
FLASK_SECRET_KEY=change-me-to-a-long-random-string
